{%- set pageTitle = (title + " — " + site.name) if title else (site.name + " — " + site.title) -%}
{%- set pageDesc = description or site.description -%}
{%- set pageUrl = page.url | absolute -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} — Blog" href="/feed.xml">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)">

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ (image or '/assets/img/og.jpg') | absolute }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- if layout == 'layouts/post.njk' %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:author" content="{{ site.name }}">
  {%- endif %}

  <script>
    try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">emre<span>tüfekçi</span></a>
      <nav aria-label="Main">
        <a href="/#work">Work</a>
        <a href="/blog/"{% if '/blog/' in page.url %} aria-current="page"{% endif %}>Blog</a>
        <a href="/#contact">Contact</a>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <p>© {{ year }} {{ site.name }}</p>
      <p>
        <a href="{{ site.github }}">GitHub</a> ·
        <a href="{{ site.linkedin }}">LinkedIn</a> ·
        <a href="/feed.xml">RSS</a> ·
        <a href="{{ site.repo }}">Source</a>
      </p>
    </div>
  </footer>
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
